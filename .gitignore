# Local .terraform directories (providers, modules, backend config)
**/.terraform/

# State files - state lives in the S3 backend, never in git
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Saved plan files
*.tfplan
tfplan

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# OS / editor noise
.DS_Store
.idea/
.vscode/
*.swp

# Note: .terraform.lock.hcl is intentionally NOT ignored - commit it so
# everyone (and CI) uses the same provider versions.
